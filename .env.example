# Production environment for the hub API. Copy to .env on the host and fill
# in. Every value here is read by hub_api.config.Settings.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# There is deliberately no development fallback: a fallback secret that
# reaches production is indistinguishable from having none.
HUB_TOKEN_SECRET=
POSTGRES_PASSWORD=

HUB_BASE_URL=https://hub.spikeforge.net
ARTIFACT_PUBLIC_BASE=https://cdn.spikeforge.net
HUB_CORS_ORIGINS=https://dash.spikeforge.net

# Enabled OAuth2 providers, as JSON: {"provider": ["client_id", "secret"]}.
# A provider absent here is not offered, so the sign-in page renders only
# buttons that work. Presets exist for github, google, gitlab, discord,
# twitch, microsoft and orcid. The callback to register with each provider
# is <HUB_BASE_URL>/oauth/<provider>/callback.
HUB_OAUTH_PROVIDERS={}

# invite | open. invite keeps publishing closed while moderation capacity
# is one person: every upload is content this deployment hosts and answers
# for. The operator has chosen open from launch.
HUB_PUBLISHING_GATE=open

# With no verification plane configured, set this false and uploads publish
# carrying the honest "unchecked" label. Leaving it true holds every upload
# in the verifying state, which is correct but makes the hub look broken.
HUB_REQUIRE_VERIFICATION=true

# The share of the attached volume this service may ever claim, and the free
# space below which it refuses uploads regardless. The volume's other tenant
# is a growing video library; these two numbers are what stop this service
# taking it down. Defaults: 10 GiB and 5 GiB.
HUB_FOOTPRINT_CAP_BYTES=10737418240
HUB_VOLUME_FREE_FLOOR_BYTES=5368709120
